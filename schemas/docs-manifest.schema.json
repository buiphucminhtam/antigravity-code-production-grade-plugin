{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forgewright.local/schemas/docs-manifest.schema.json",
  "title": "Forgewright Docs Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "sources", "privacy"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/source"
      }
    },
    "truth": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/relativePath"
      },
      "default": []
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git": {
          "type": "boolean",
          "default": true
        },
        "gitnexus": {
          "type": "boolean",
          "default": false
        },
        "evidence_summary": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "const": "allowlist"
        },
        "allow": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/relativePath"
          },
          "default": []
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/relativePath"
          },
          "default": []
        }
      }
    }
  },
  "definitions": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type"],
      "properties": {
        "path": {
          "$ref": "#/definitions/relativePath"
        },
        "type": {
          "type": "string",
          "enum": [
            "documentation",
            "overview",
            "architecture",
            "product",
            "testing",
            "operations",
            "assets",
            "metadata"
          ]
        },
        "include": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    }
  }
}
