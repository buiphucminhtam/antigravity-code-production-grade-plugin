{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forgewright.dev/schemas/art-direction-gates.schema.json",
  "title": "Forgewright Art Direction Gates",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "concept_packet", "style_dna", "gates"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^art-direction-gates/v[0-9]+$"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "concept_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "version", "project_id", "selected_direction_id"],
      "properties": {
        "packet_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "selected_direction_id": { "type": "string", "minLength": 1 }
      }
    },
    "style_dna": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "version", "status", "evidence"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["DRAFT", "APPROVED"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept-packet", "style-frame", "representative-family", "production"],
      "properties": {
        "concept-packet": { "$ref": "#/$defs/gate" },
        "style-frame": { "$ref": "#/$defs/gate" },
        "representative-family": { "$ref": "#/$defs/gate" },
        "production": { "$ref": "#/$defs/gate" }
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "required", "status", "evidence", "owner", "next_action"],
      "properties": {
        "applicable": { "type": "boolean" },
        "required": { "type": "boolean" },
        "status": { "type": "string", "enum": ["PASS", "CONCERNS", "FAIL"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "owner": { "type": "string", "minLength": 1 },
        "next_action": { "type": "string", "minLength": 1 }
      }
    }
  }
}
