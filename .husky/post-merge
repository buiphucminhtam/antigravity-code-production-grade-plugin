#!/bin/sh
# A source pull is not permission to update shared runtimes or other workspaces.
# Keep maintenance explicit, just like post-commit; never spawn hidden work.
set -eu

CACHE_DIR=".forgewright/cache"
mkdir -p "$CACHE_DIR"
for marker in mcp-sync-needed wiki-sync-needed reindex-needed submodule-update-needed; do
  : > "$CACHE_DIR/$marker"
done
echo "[Forgewright] Source updated; project-local maintenance is pending. No shared runtime or submodule was changed."
